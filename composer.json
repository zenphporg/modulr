{
  "name": "zenphp/modulr",
  "description": "Turn your Laravel applications modular with Modulr!",
  "keywords": [
    "laravel",
    "modules",
    "modulr"
  ],
  "authors": [
    {
      "name": "Jetstream Labs, LLC.",
      "email": "hello@jetstreamlabs.com"
    },
    {
      "name": "Chris Morrell",
      "homepage": "http://www.cmorrell.com"
    }
  ],
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "ext-dom": "*",
    "ext-json": "*",
    "ext-simplexml": "*",
    "composer/composer": "^2.8.9",
    "illuminate/support": "^11.0|^12.0"
  },
  "require-dev": {
    "mockery/mockery": "^1.6.12",
    "zenphp/fixr": "^1.0.3",
    "rector/rector": "^2.0",
    "pestphp/pest": "^3.8 || ^4.0",
    "orchestra/testbench": "^10.4",
    "larastan/larastan": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "Zen\\Modulr\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Zen\\Modulr\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "fix": "vendor/bin/fixr",
    "test": "vendor/bin/pest",
    "test:coverage": "vendor/bin/pest --coverage",
    "analyze": "phpstan analyze"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Zen\\Modulr\\ModulrServiceProvider"
      ],
      "aliases": {
        "Modulr": "Zen\\Modulr\\Support\\Facades\\Modulr"
      }
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
