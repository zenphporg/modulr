{
  "name": "zenphp/modulr",
  "description": "Turn your Laravel applications modular with Modulr!",
  "keywords": [
    "laravel",
    "modules",
    "modulr"
  ],
  "authors": [
    {
      "name": "Jetstream Labs, LLC.",
      "email": "hello@jetstreamlabs.com"
    },
    {
      "name": "Chris Morrell",
      "homepage": "http://www.cmorrell.com"
    }
  ],
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "ext-dom": "*",
    "ext-json": "*",
    "ext-simplexml": "*",
    "composer/composer": "^2.9.7",
    "illuminate/support": "^11.0|^12.0|^13.0"
  },
  "require-dev": {
    "mockery/mockery": "^1.6.12",
    "zenphp/fixr": "^1.0.4",
    "rector/rector": "^2.4.2",
    "pestphp/pest": "^4.7.0",
    "orchestra/testbench": "^10.11.0",
    "larastan/larastan": "^3.9.6",
    "pestphp/pest-plugin-type-coverage": "^4.0.4",
    "pestphp/pest-plugin-laravel": "^4.1.0",
    "driftingly/rector-laravel": "^2.3.0"
  },
  "autoload": {
    "psr-4": {
      "Zen\\Modulr\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Zen\\Modulr\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "lint": [
      "./vendor/bin/rector",
      "./vendor/bin/fixr"
    ],
    "test:types": "./vendor/bin/pest --type-coverage --parallel --min=100",
    "test:lint": [
      "./vendor/bin/rector --dry-run",
      "./vendor/bin/fixr --test"
    ],
    "test:feat": "./vendor/bin/pest",
    "test:coverage": "./vendor/bin/pest --compact --coverage --coverage-clover=clover.xml --min=100.0; php bin/clean-coverage",
    "test:static": "./vendor/bin/phpstan analyze",
    "test": [
      "@test:types",
      "@test:static",
      "@test:lint",
      "@test:feat"
    ]
  },
  "extra": {
    "laravel": {
      "providers": [
        "Zen\\Modulr\\ModulrServiceProvider"
      ],
      "aliases": {
        "Modulr": "Zen\\Modulr\\Support\\Facades\\Modulr"
      }
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
